{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@PixelBuddy/api": "*",
    "@PixelBuddy/db": "*",
    "@PixelBuddy/env": "*",
    "@fastify/cors": "^11.3.0",
    "@orpc/openapi": "^1.14.12",
    "@orpc/server": "^1.14.12",
    "@orpc/zod": "^1.14.12",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@PixelBuddy/config": "*",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
