{
  "name": "PixelBuddy",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native:ios": "cd apps/native && npx expo start --dev-client --ios",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @PixelBuddy/db --",
    "db:studio": "turbo run db:studio -F @PixelBuddy/db --",
    "db:generate": "turbo run db:generate -F @PixelBuddy/db --",
    "db:migrate": "turbo run db:migrate -F @PixelBuddy/db --",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@PixelBuddy/env": "*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@PixelBuddy/config": "*",
    "@biomejs/biome": "2.5.3",
    "@types/node": "^26.2.0",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "ultracite": "7.9.4"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "@shopify/react-native-skia@2.6.2": true
  }
}
